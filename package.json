{
  "name": "@eip-1193/jsonrpc-provider",
  "version": "0.5.0",
  "keywords": [
    "eip-1193",
    "ethereum",
    "provider",
    "json-rpc",
    "http",
    "batch",
    "throttle"
  ],
  "author": "wighawag <wighawag@gmail.com>",
  "homepage": "https://github.com/wighawag/eip-1193-jsonrpc-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/eip-1193-jsonrpc-provider.git"
  },
  "bugs": {
    "url": "https://github.com/wighawag/eip-1193-jsonrpc-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "pkgroll": "^2.0.2",
    "prettier": "^3.2.5",
    "set-defaults": "^0.0.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "eip-1193": "^0.7.0",
    "named-logs": "^0.3.2",
    "promise-throttle": "^1.1.2"
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "build": "pkgroll",
    "dev": "pkgroll --watch",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test test/*.test.mjs",
    "format": "prettier --write .",
    "release:ci": "pnpm format:check && pnpm test && pnpm changeset publish"
  }
}
