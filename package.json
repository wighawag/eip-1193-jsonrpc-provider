{
  "name": "eip-1193-jsonrpc-provider",
  "version": "0.4.3",
  "keywords": [
    "eip-1193",
    "ethereum",
    "provider",
    "json-rpc",
    "http",
    "batch",
    "throttle"
  ],
  "author": "wighawag <wighawag@gmail.com>",
  "homepage": "https://github.com/wighawag/eip-1193-jsonrpc-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/eip-1193-jsonrpc-provider.git"
  },
  "bugs": {
    "url": "https://github.com/wighawag/eip-1193-jsonrpc-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "eip-1193": "^0.6.2",
    "pkgroll": "^2.0.2",
    "prettier": "^3.2.5",
    "set-defaults": "^0.0.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "named-logs": "^0.3.2",
    "promise-throttle": "^1.1.2"
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "build": "pkgroll",
    "dev": "pkgroll --watch",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  }
}
